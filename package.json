{
  "name": "xiaoshuaji-leetcode-review",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --exclude 'tests/integration/**'",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build",
    "prepare": "wxt prepare"
  },
  "dependencies": {
    "@wxt-dev/module-react": "1.2.2",
    "dexie": "4.4.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "ts-fsrs": "5.4.1",
    "wxt": "0.20.27",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/chrome": "0.1.33",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.38.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "27.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "4.0.8"
  }
}
